<Window x:Class="dsh_deploy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dsh_deploy"
        xmlns:vm="clr-namespace:dsh_deploy.ViewModels"
        mc:Ignorable="d"
        Title="DSH Deploy Manager" 
        Height="500" Width="450"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF9800"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F57C00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <StackPanel>
                <TextBlock Text="DSH Deploy Manager" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"/>
                <TextBlock Text="DeepSeek Harness 部署管理工具" 
                           Foreground="#E3F2FD" 
                           FontSize="12" 
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 状态区域 -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="10,10,10,0" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Opacity="0.2" ShadowDepth="1"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- 服务状态 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 状态指示灯 -->
                    <Ellipse Grid.Column="0" 
                             Width="12" Height="12" 
                             Fill="{Binding StatusColor}" 
                             Margin="0,0,10,0"/>
                    
                    <!-- 状态文本 -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="服务状态" 
                                   FontSize="12" 
                                   Foreground="#757575"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#212121"/>
                    </StackPanel>
                    
                    <!-- 端口信息 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="端口" 
                                   FontSize="12" 
                                   Foreground="#757575" 
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Port}" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#212121"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
                
                <!-- 进程信息 -->
                <TextBlock Text="{Binding ProcessInfo}" 
                           FontSize="12" 
                           Foreground="#9E9E9E" 
                           Margin="0,10,0,0"
                           Visibility="{Binding ProcessInfo, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- 仪表盘指标 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 运行时长 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="运行时长" FontSize="10" Foreground="#757575"/>
                        <TextBlock Text="{Binding DashboardData.Uptime}" FontSize="12" FontWeight="Bold" Foreground="#212121"/>
                    </StackPanel>
                    
                    <!-- 内存使用 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="内存(MB)" FontSize="10" Foreground="#757575"/>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#212121">
                            <TextBlock.Text>
                                <Binding Path="DashboardData.MemoryUsage" StringFormat="{}{0:F1}"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 健康状态 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="健康状态" FontSize="10" Foreground="#757575"/>
                        <TextBlock Text="{Binding DashboardData.HealthStatus.StateText}" FontSize="12" FontWeight="Bold" Foreground="{Binding DashboardData.HealthStatus.StateColor}"/>
                    </StackPanel>
                    
                    <!-- 日志统计 -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="错误数" FontSize="10" Foreground="#757575"/>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#F44336">
                            <TextBlock.Text>
                                <Binding Path="DashboardData.LogStatistics.ErrorCount" StringFormat="{}{0}"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                
                <!-- 最后更新时间 -->
                <TextBlock FontSize="11" 
                           Foreground="#BDBDBD" 
                           Margin="0,5,0,0">
                    <TextBlock.Text>
                        <Binding StringFormat="最后更新: {0:HH:mm:ss}"/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
        
        <!-- 操作按钮区域 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 主要操作按钮 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="启动服务" 
                        Command="{Binding StartCommand}"
                        Style="{StaticResource SuccessButton}"
                        Width="100"/>
                <Button Content="停止服务" 
                        Command="{Binding StopCommand}"
                        Style="{StaticResource DangerButton}"
                        Width="100"/>
                <Button Content="重启服务" 
                        Command="{Binding RestartCommand}"
                        Style="{StaticResource WarningButton}"
                        Width="100"/>
                <Button Content="最小化到托盘" 
                        Command="{Binding MinimizeToTrayCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"/>
            </StackPanel>
            
            <!-- 次要操作按钮 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="打开Web界面" 
                        Command="{Binding OpenWebCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"/>
                <Button Content="刷新状态" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"/>
                <Button Content="清理端口" 
                        Command="{Binding CleanupOrphanProcessesCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"/>
                <Button Content="系统诊断" 
                        Command="{Binding RunDiagnosticsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"/>
            </StackPanel>
            
            <!-- 日志区域 -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,10,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" Opacity="0.2" ShadowDepth="1"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 日志标题和过滤器 -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8" CornerRadius="8,8,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="日志" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Foreground="#424242"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="清空" 
                                            Command="{Binding ClearLogCommand}"
                                            Background="Transparent"
                                            Foreground="#757575"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- 过滤器 -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="级别：" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" 
                                          SelectedItem="{Binding LogFilterLevel}" 
                                          Width="80" Margin="5,0"
                                          FontSize="11">
                                    <ComboBoxItem Content="DEBUG" Tag="0"/>
                                    <ComboBoxItem Content="INFO" Tag="1"/>
                                    <ComboBoxItem Content="WARN" Tag="2"/>
                                    <ComboBoxItem Content="ERROR" Tag="3"/>
                                </ComboBox>
                                
                                <TextBlock Grid.Column="2" Text="关键词：" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="3" 
                                         Text="{Binding LogFilterKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="120" Margin="5,0"
                                         FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- 日志列表 -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredLogs}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullDisplay}" 
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding LevelColor}"
                                           Margin="10,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#E0E0E0" Padding="10,5">
            <Grid>
                <TextBlock Text="DSH Deploy Manager v1.0" 
                           FontSize="11" 
                           Foreground="#757575"
                           VerticalAlignment="Center"/>
                <Button Content="退出" 
                        Command="{Binding ExitCommand}"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#757575"
                        BorderThickness="0"
                        Padding="8,4"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
